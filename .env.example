# ============================================================
# 青启e城 · 环境变量模板
# 用法：复制本文件为 .env 后填写（.env 已被 .gitignore 忽略，不会提交到 GitHub）
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# ============================================================

# ---- JWT 签名密钥（必填）----
# Base64 编码。后端启动时缺少该变量会直接报错（fail-fast），不会带默认密钥运行。
# 本地演示可直接使用下面的示例值；正式/对外部署请生成自己的随机值：
#   Linux/macOS 生成：  echo -n "你的任意长随机串" | base64
#   Windows 生成：  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("你的任意长随机串"))
JWT_SECRET=cWluZ3FpLWVjaXR5LWp3dC1zZWNyZXQta2V5LTIwMjQ=

# ---- 对话引擎 Agent 模式（可选）----
# 三项任选其一：
#   ① 留空（CHAT_LLM_API_KEY 为空）= 本地规则模式（local），无需联网也能演示，AI 不会生效；
#   ② 本机 Ollama（离线 AI）：API_KEY 填任意非空值（如 ollama），ENDPOINT 指向本机 Ollama，MODEL 填已拉取的模型名；
#   ③ 云端 API（豆包/DeepSeek）：填真实 API Key 与对应 ENDPOINT/MODEL（见 docs/deployment/06-ai-llm.md）。
# 填写后由对话引擎 agent 模式调用 LLM 增强回答（本地 RAG 仍负责召回与来源引用）；
# 依赖 LLM 的功能：智能客服 agent 模式 + 反诈情景演练；保函 AI 复审 / 学生证 OCR 为本地模拟，不受影响。
CHAT_ENGINE=local
CHAT_LLM_API_KEY=
CHAT_LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
CHAT_LLM_MODEL=doubao-pro-32k
# Ollama 本地模式示例（取消注释并使用）：
# CHAT_ENGINE=agent
# CHAT_LLM_API_KEY=ollama
# CHAT_LLM_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
# CHAT_LLM_MODEL=qwen2.5:3b-instruct

# ---- 数据库 / 缓存（本地演示默认，一般无需修改）----
# 注意：本机 Docker 数据卷已按 123456 初始化，修改后需重建数据卷，请谨慎
# MYSQL_ROOT_PASSWORD=123456
# REDIS_PASSWORD=
